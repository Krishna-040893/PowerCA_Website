NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdldnd6enJ6dHJpa3RkYXpmYnB3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTc1MzA3OTYsImV4cCI6MjA3MzEwNjc5Nn0.QCS5nlpPkMYWkimxJjqugai5bT_KrVcNcghE81orG5k"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdldnd6enJ6dHJpa3RkYXpmYnB3Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzUzMDc5NiwiZXhwIjoyMDczMTA2Nzk2fQ.DjB7jQpszsh7lFsTYhwgHLDatDkZECwEcpUI_AJnSIs"

# Development/Production Mode
NODE_ENV="development"

# Admin Setup (for scripts only - DO NOT commit with real values)
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="use-strong-password-here"
# ADMIN_EMAIL="admin@yourdomain.com"

# Optional: Cloud Storage (for file uploads)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET="powerca-uploads"

# Optional: SMS Service (for OTP)
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_PHONE_NUMBER="+1234567890"

# Optional: WhatsApp Business API
# WHATSAPP_API_KEY="your-whatsapp-api-key"
# WHATSAPP_PHONE_ID="your-whatsapp-phone-id"

# Sentry Error Tracking (Recommended for Production)
# Get from: https://sentry.io/settings/your-org/projects/your-project/keys/
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/your-project-id"
SENTRY_ORG="your-org-name"
SENTRY_PROJECT="your-project-name"
SENTRY_AUTH_TOKEN="your-auth-token"

# Optional: Enable Sentry in development (default: false)
# NEXT_PUBLIC_SENTRY_DEBUG="false"
# SENTRY_DEBUG="false"

# Optional: Redis (for caching/sessions)
# REDIS_URL="redis://localhost:6379"

# Optional: Email Templates (if using custom SMTP instead of Resend)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Optional: Google OAuth (for social login)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: Microsoft OAuth (for social login)
# AZURE_AD_CLIENT_ID="your-azure-client-id"
# AZURE_AD_CLIENT_SECRET="your-azure-client-secret"
# AZURE_AD_TENANT_ID="your-azure-tenant-id"

# HubSpot Integration
# Get from: https://app.hubspot.com/private-apps
HUBSPOT_PRIVATE_APP_TOKEN="your-hubspot-private-app-token"
# Get from: Settings > Account > API
NEXT_PUBLIC_HUBSPOT_PORTAL_ID="your-hubspot-portal-id"
