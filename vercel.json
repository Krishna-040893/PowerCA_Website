{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.powerca.in"
        }
      ],
      "destination": "https://powerca.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "power-ca-website.vercel.app"
        }
      ],
      "destination": "https://powerca.in/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/subscriptions/check-renewal-eligibility",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 10
    },
    "src/app/api/invoice/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/payment/verify/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/payment/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/subscriptions/check-renewal-eligibility/route.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    }
  ]
}
